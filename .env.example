# OpenAI provider settings. Copy this file to `.env` and fill in real values.
OPENAI_API_KEY=

# Optional OpenAI organization/project identifiers, if your account uses them.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Optional API base override. Leave blank for the public OpenAI API.
OPENAI_BASE_URL=

# Optional built-in OpenAI-compatible providers.
FIREWORKS_API_KEY=
GEMINI_API_KEY=
